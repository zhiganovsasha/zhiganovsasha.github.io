---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'development' | 'education' | 'contact' | 'blog';
  lang?: string;
}

const {
  title,
  description = 'Alexander Zhiganov, Creative Technologist. I bring ideas to life across art, technology, and AI, from research to finished work.',
  current,
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        var palettes = [
          /* Theme 1: Apple Intelligence / Siri */
          ['#4f5bd5', '#962fbf', '#d62976', '#fa7e1e', '#feda75', '#38bdf8', '#4f5bd5'],
          /* Theme 2: Instagram Sunset / Aurora */
          ['#5851db', '#833ab4', '#c13584', '#e1306c', '#fd1d1d', '#f77737', '#fcaf45'],
          /* Theme 3: Cyber Prismatic / Neon Opal */
          ['#3b82f6', '#8b5cf6', '#ec4899', '#f43f5e', '#fb923c', '#06b6d4', '#10b981']
        ];
        var chosen = palettes[Math.floor(Math.random() * palettes.length)];
        var root = document.documentElement;
        chosen.forEach(function(c, i) {
          root.style.setProperty('--grad-' + (i + 1), c);
        });
        var angle = Math.floor(108 + Math.random() * 18) + 'deg';
        root.style.setProperty('--grad-angle', angle);
        var baseDelay = -(Math.random() * 14).toFixed(2) + 's';
        root.style.setProperty('--rand-delay', baseDelay);

        function initHoverRandomizer() {
          var items = document.querySelectorAll('.brand, .main-nav > a');
          items.forEach(function(item) {
            item.addEventListener('pointerenter', function() {
              var hoverDelay = -(Math.random() * 14).toFixed(2) + 's';
              item.style.setProperty('--hover-delay', hoverDelay);
            });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initHoverRandomizer);
        } else {
          initHoverRandomizer();
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
