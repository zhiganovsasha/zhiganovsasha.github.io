---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  role: string;
  status?: string;
  pageTitle: string;
  rainbowTitle?: boolean;
}

const { title, role, status, pageTitle, rainbowTitle = true } = Astro.props;
---

<Base title={pageTitle} current="development">
  <article class="case">
    <header class="case-head">
      <div class="wrap">
        <a class="back" href="/development"
          ><span aria-hidden="true">←</span> Back to AI Development</a
        >
        <p class="case-meta">
          Case Study
          {status && <span class="status">{status}</span>}
        </p>
        <h1 class:list={['display', 'case-title', { 'rainbow-gradient': rainbowTitle }]}>{title}</h1>
        <p class="lede case-role">{role}</p>
      </div>
    </header>
    <div class="wrap case-body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .case-head {
    padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px);
    background: var(--bg-surface);
    border-bottom: 1px solid var(--rule);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-block: 4px;
    font-size: var(--type-small);
    color: var(--mute);
    text-decoration: none;
    margin-bottom: 24px;
    transition:
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .back:hover {
    color: var(--signal);
  }

  .back:active {
    transform: translateX(-2px);
  }

  .case-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--signal);
    font-size: var(--type-small);
    font-weight: 600;
  }

  .status {
    font-size: var(--type-small);
    letter-spacing: 0;
    color: var(--signal);
    border: 1px solid var(--signal);
    padding: 4px 10px;
  }

  .case-title {
    font-size: clamp(44px, 6.4vw, 88px);
    margin-top: 18px;
  }

  .case-title.rainbow-gradient {
    display: inline;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    background: var(--grad-spectrum);
    background-size: 280% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: rainbow-shimmer 14s ease-in-out infinite;
    animation-delay: var(--rand-delay, 0s);
  }

  .case-role {
    margin-top: 24px;
    max-width: 52ch;
  }

  .case-body {
    padding-block: clamp(40px, 5vw, 72px) clamp(64px, 8vw, 120px);
    display: grid;
    grid-template-columns: minmax(240px, 0.62fr) minmax(0, 1.38fr);
    gap: 24px clamp(32px, 5vw, 80px);
  }

  .case-body :global(h2) {
    max-width: 18ch;
    font-size: var(--type-heading);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0;
  }

  .case-body :global(.case-section) {
    display: contents;
  }

  .case-body :global(.case-content) {
    max-width: 62ch;
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .case-body :global(.case-content p) {
    margin: 0 0 1em;
  }

  .case-body :global(.case-content a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--signal);
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .case-body :global(.case-content a:hover) {
    color: var(--signal);
    text-decoration-color: var(--signal);
  }

  .case-body :global(.case-content ul) {
    margin: 0 0 1em;
    padding-left: 1.2em;
  }

  .case-body :global(.case-content li) {
    margin-bottom: 0.4em;
  }

  .case-body :global(.stack-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }

  .case-body :global(.stack-list li) {
    font-size: var(--type-small);
    padding: 6px 12px;
    border: 1px solid var(--rule-strong);
    margin: 0;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .case-body :global(.stack-list li:hover) {
    border-color: var(--ink);
    background-color: var(--field);
  }

  .case-body :global(.pull-quote) {
    border-left: 2px solid var(--ink);
    padding-left: 24px;
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 550;
    letter-spacing: -0.015em;
    line-height: 1.35;
    margin: 0 0 1.2em;
  }

  .case-body :global(.case-figure) {
    margin: 0 0 2em;
    border: 1px solid var(--rule);
    background: var(--field);
    overflow: hidden;
  }

  .case-body :global(.case-img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-body :global(figcaption) {
    padding: 10px 16px;
    font-size: var(--type-small);
    color: var(--mute);
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }

  @media (max-width: 760px) {
    .case-body {
      grid-template-columns: 1fr;
    }
  }
</style>
