---

<Base
  title="Education & Speaking — Alexander Zhiganov"
  description="Keynotes, hands-on workshops, and educational programs on autonomous AI agents, commercial generative video, and interactive technology."
  current="education"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 class="display hero-title">Education &amp; Speaking</h1>
        <p class="lede hero-lede">
          I turn production engineering and generative pipelines into actionable frameworks.
        </p>
        <p class="hero-body muted">
          I lecture, lead intensive workshops, and deliver keynotes on autonomous AI agents,
          commercial video production, and interactive technology for engineering teams, creative festivals,
          and universities worldwide.
        </p>

        <ul class="credentials-list" role="list">
          <li class="credential-item">
            <span class="cred-dot" aria-hidden="true"></span>
            <span>G8 Creative Industries Festival Speaker</span>
          </li>
          <li class="credential-item">
            <span class="cred-dot" aria-hidden="true"></span>
            <span>ArtMasters &amp; TIME CODE Lecturer</span>
          </li>
          <li class="credential-item">
            <span class="cred-dot" aria-hidden="true"></span>
            <span>Peer-Reviewed AI Research Co-Author (eLibrary / RSCI)</span>
          </li>
          <li class="credential-item">
            <span class="cred-dot" aria-hidden="true"></span>
            <span>Featured in Reuters, Tinkoff Journal &amp; National TV</span>
          </li>
        </ul>

        <div class="hero-actions">
          <a class="btn btn-primary" href="#programs">
            Explore Programs <span aria-hidden="true">↓</span>
          </a>
          <a class="btn btn-ghost" href="#contact">
            Book a Talk or Workshop <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="hero-media-stack">
        <figure class="hero-portrait">
          <Image
            src={portrait}
            alt="Portrait of Alexander Zhiganov, Educator and Speaker"
            widths={[560, 900, 1400]}
            sizes="(max-width: 900px) 100vw, 48vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <figure class="hero-stage-card">
          <Image
            src={stagePhoto}
            alt="Alexander Zhiganov delivering a keynote on creative technology and neural production"
            widths={[600, 1000, 1600]}
            sizes="(max-width: 900px) 100vw, 48vw"
            loading="eager"
          />
          <figcaption class="stage-caption">Keynote on creative technology &amp; neural production</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section programs-section" id="programs" aria-labelledby="programs-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="programs-title">Ready-to-Book Programs</h2>
        <p class="section-lead muted">
          Structured curricula engineered for conference stages, corporate offsites, and intensive team sprints. Available in-person in the UAE and worldwide, or remotely.
        </p>
      </div>

      <div class="programs-grid">
        <article class="program-card">
          <div class="card-head">
            <h3 class="card-title">Autonomous AI Workflows for Modern Teams</h3>
            <p class="card-pitch">
              How modern engineering and creative teams build and ship production software, bots, and automated pipelines using autonomous AI agents instead of bloated engineering stacks.
            </p>
          </div>

          <div class="card-meta">
            <div class="meta-row">
              <span class="meta-label">Available Formats:</span>
              <span class="meta-value">Keynote (45 min), Intensive Workshop (2–4 hours), Guest Lecture</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Target Audience:</span>
              <span class="meta-value">Engineering leads, product managers, creative technologists, startup founders</span>
            </div>
          </div>

          <div class="card-takeaways">
            <h4 class="takeaways-title">Key Takeaways</h4>
            <ul class="takeaways-list" role="list">
              <li>Structuring production agentic workflows with Antigravity, Codex, and MCP servers</li>
              <li>Context architecture, deterministic guardrails, and safe background tool execution</li>
              <li>Moving from zero lines of code to production-grade deployment with verified case studies</li>
            </ul>
          </div>

          <div class="card-actions">
            <a class="btn btn-card" href="#contact">
              Book This Program <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="program-card">
          <div class="card-head">
            <h3 class="card-title">Commercial AI Video Production</h3>
            <p class="card-pitch">
              Production-proven generative video pipelines from initial conceptual development to broadcast-grade delivery and large-format DOOH screens.
            </p>
          </div>

          <div class="card-meta">
            <div class="meta-row">
              <span class="meta-label">Available Formats:</span>
              <span class="meta-value">Keynote (45 min), Studio Workshop (3–4 hours), Masterclass</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Target Audience:</span>
              <span class="meta-value">Production studios, art directors, motion designers, brand marketers</span>
            </div>
          </div>

          <div class="card-takeaways">
            <h4 class="takeaways-title">Key Takeaways</h4>
            <ul class="takeaways-list" role="list">
              <li>Overcoming diffusion hallucinations, flickering, and temporal consistency challenges</li>
              <li>Multi-machine distributed rendering pipelines, frame interpolation, and post-processing</li>
              <li>Real production breakdowns: the Kirigami dance film (3,250 frames) and MAER nationwide DOOH campaign</li>
            </ul>
          </div>

          <div class="card-actions">
            <a class="btn btn-card" href="#contact">
              Book This Program <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="program-card">
          <div class="card-head">
            <h3 class="card-title">Experiential Tech &amp; Festival Installations</h3>
            <p class="card-pitch">
              Designing, engineering, and producing interactive media art, real-time computer vision systems, and large-scale festival installations that engage physical audiences.
            </p>
          </div>

          <div class="card-meta">
            <div class="meta-row">
              <span class="meta-label">Available Formats:</span>
              <span class="meta-value">Keynote (45 min), Masterclass, Panel Discussion</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Target Audience:</span>
              <span class="meta-value">Festival curators, experiential agencies, spatial designers, cultural institutions</span>
            </div>
          </div>

          <div class="card-takeaways">
            <h4 class="takeaways-title">Key Takeaways</h4>
            <ul class="takeaways-list" role="list">
              <li>Real-time computer vision in physical environments using OpenCV, WebGL, and custom sensors</li>
              <li>Hardware and software resilience under high-load live festival conditions (Intervals, Outline, Signal)</li>
              <li>Designing cultural phenomena: from morning coffeehouse raves to multi-day art interventions</li>
            </ul>
          </div>

          <div class="card-actions">
            <a class="btn btn-card" href="#contact">
              Book This Program <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section registry-section" id="registry" aria-labelledby="registry-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="registry-title">Selected Appearances &amp; Media Track Record</h2>
        <p class="section-lead muted">
          A documented chronological registry of keynotes, university lectures, peer-reviewed publications, and broadcast appearances across 2023–2026.
        </p>
      </div>

      <div class="table-wrap">
        <table class="registry-table" aria-label="Chronological registry of speaking appearances, lectures, and media features">
          <thead>
            <tr>
              <th scope="col" class="th-year">Year</th>
              <th scope="col" class="th-platform">Platform / Event</th>
              <th scope="col" class="th-topic">Topic &amp; Narrative Context</th>
              <th scope="col" class="th-format">Format</th>
              <th scope="col" class="th-source">Source</th>
            </tr>
          </thead>
          <tbody>
            {registry.map((item) => (
              <tr class="registry-row">
                <td class="td-year">
                  <span class="year-badge">{item.year}</span>
                </td>
                <td class="td-platform">
                  <strong class="platform-name">{item.platform}</strong>
                </td>
                <td class="td-topic">
                  <p class="topic-text">{item.topic}</p>
                </td>
                <td class="td-format">
                  <span class="format-badge">{item.format}</span>
                  {item.lang && <span class="lang-tag" aria-label={`Language: ${item.lang}`}>{item.lang}</span>}
                </td>
                <td class="td-source">
                  <a
                    class="source-link"
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${item.linkText}: ${item.platform} (opens in new tab)`}
                  >
                    <span>{item.linkText}</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section cta-section" id="book" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta-box">
        <div class="cta-content">
          <h2 class="cta-title" id="cta-title">Book Alexander for Your Event or Team</h2>
          <p class="cta-lead">
            Planning a conference keynote, an intensive corporate workshop, or an academic guest lecture?
            I am available for engagements in the UAE and internationally. Let's discuss formats, dates, and custom curricula.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href="#contact">
            Contact Details <span aria-hidden="true">↓</span>
          </a>
          <a
            class="btn btn-ghost"
            href="https://t.me/zhiganovsasha"
            target="_blank"
            rel="noopener noreferrer"
          >
            Direct on Telegram <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: clamp(56px, 7vw, 104px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .hero-title {
    font-size: var(--type-display);
    margin-top: 18px;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .hero-lede {
    font-size: var(--type-lead);
    margin-top: clamp(24px, 3vw, 40px);
    font-weight: 550;
    line-height: 1.35;
    color: var(--ink);
  }

  .hero-body {
    font-size: var(--type-body);
    margin-top: 16px;
    line-height: 1.55;
    max-width: 58ch;
  }

  .credentials-list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .credential-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: var(--type-small);
    color: var(--ink);
    line-height: 1.45;
  }

  .cred-dot {
    width: 6px;
    height: 6px;
    background-color: var(--signal);
    flex-shrink: 0;
    transform: translateY(-1px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(32px, 4vw, 44px);
  }

  .hero-media-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-portrait {
    margin: 0;
    background: var(--bg-sunken);
    border: 1px solid var(--border-color);
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(12%);
    transition: filter var(--dur-med) var(--ease-out);
  }

  .hero-portrait:hover img {
    filter: grayscale(0%);
  }

  .hero-stage-card {
    margin: 0;
    background: var(--bg-sunken);
    border: 1px solid var(--border-color);
    overflow: hidden;
    position: relative;
  }

  .hero-stage-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    filter: grayscale(10%);
    transition: filter var(--dur-med) var(--ease-out);
  }

  .hero-stage-card:hover img {
    filter: grayscale(0%);
  }

  .stage-caption {
    padding: 10px 14px;
    font-size: var(--type-small);
    color: var(--mute);
    background: var(--bg-surface);
    line-height: 1.4;
  }

  /* ---------- SECTION HEADS ---------- */
  .section-head {
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .section-head h2 {
    font-size: var(--type-heading);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-lead {
    font-size: var(--type-body);
    margin-top: 14px;
    max-width: 68ch;
    line-height: 1.55;
  }

  /* ---------- PROGRAMS GRID ---------- */
  .programs-section {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 32px);
    align-items: stretch;
  }

  .program-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    padding: clamp(24px, 2.5vw, 36px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .program-card:hover {
    border-color: var(--signal);
    transform: translateY(-2px);
  }

  .card-head {
    margin-bottom: 24px;
  }

  .card-title {
    font-size: var(--type-lead);
    line-height: 1.25;
    margin: 0 0 12px;
    font-weight: 600;
    color: var(--ink);
  }

  .card-pitch {
    font-size: var(--type-body);
    color: var(--mute);
    line-height: 1.5;
    margin: 0;
  }

  .card-meta {
