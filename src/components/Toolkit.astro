---
const groups = [
  {
    label: 'Models & inference',
    items: ['DeepSeek V4 Flash', 'DeepSeek V4 Pro', 'Gemma 4 12B', 'Qwen3 Embedding 8B'],
  },
  {
    label: 'Creative AI',
    items: ['Stable Diffusion', 'Midjourney', 'Runway', 'Higgsfield', 'Seedance'],
  },
  {
    label: 'Speech & documents',
    items: ['Yandex SpeechKit', 'Whisper', 'Tesseract', 'Docling', 'OCRmyPDF'],
  },
  {
    label: 'Infrastructure',
    items: ['OpenRouter', 'Replicate', 'Ollama', 'ChromaDB', 'MCP'],
  },
  {
    label: 'AI Agents',
    items: ['OpenAI Codex', 'Google Antigravity', 'OpenCode'],
  },
];
---

<section class="section toolkit" aria-labelledby="toolkit-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="toolkit-title">My AI Toolkit</h2>
      <p class="note">
        Full stacks live inside the case studies. This is the everyday working
        set.
      </p>
    </div>
    <dl class="toolkit-grid">
      {
        groups.map((group) => (
          <div class="toolkit-group">
            <dt>{group.label}</dt>
            <dd>
              <ul class="chip-list" role="list">
                {group.items.map((item) => (
                  <li class="chip" translate="no">{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .note {
    max-width: 300px;
    font-size: var(--type-small);
    color: var(--mute);
    margin: 0;
  }

  .toolkit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    background: transparent;
    border: none;
    margin: 0;
  }

  .toolkit-group {
    background: var(--bg-surface);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-sm);
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .toolkit-group dt {
    font-size: var(--type-small);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--mute);
    margin-bottom: 16px;
  }

  .toolkit-group dd {
    margin: 0;
  }

  .chip-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font-size: var(--type-small);
    padding: 6px 12px;
    background: var(--bg-sunken);
    border: 1px solid transparent;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .chip:hover {
    border-color: var(--ink);
    background-color: #ffffff;
    box-shadow: var(--shadow-xs);
    transform: translateY(-1px);
  }
</style>
