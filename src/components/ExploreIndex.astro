---
// Explore index: four directions, one active, three unavailable with dialogs.
---

<section class="section explore" aria-labelledby="explore-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="explore-title">What Would You Like to Explore?</h2>
    </div>

    <ul class="dir-list" role="list">
      <li>
        <a
          class="dir-row active"
          href="/development"
          aria-label="AI Development: Production products, cases, AI pipelines"
        >
          <span class="dir-name">AI Development</span>
          <span class="dir-meta">Production products, cases, AI pipelines</span>
          <span class="dir-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <button
          class="dir-row muted-row"
          type="button"
          data-dialog="dialog-art"
          aria-haspopup="dialog"
          aria-controls="dialog-art"
        >
          <span class="dir-name">Art Projects</span>
          <span class="dir-hint">Not part of this release</span>
        </button>
      </li>
      <li>
        <button
          class="dir-row muted-row"
          type="button"
          data-dialog="dialog-education"
          aria-haspopup="dialog"
          aria-controls="dialog-education"
        >
          <span class="dir-name">Education &amp; Speaking</span>
          <span class="dir-hint">Not part of this release</span>
        </button>
      </li>
      <li>
        <button
          class="dir-row muted-row"
          type="button"
          data-dialog="dialog-blog"
          aria-haspopup="dialog"
          aria-controls="dialog-blog"
        >
          <span class="dir-name">Blog</span>
          <span class="dir-hint">Not part of this release</span>
        </button>
      </li>
    </ul>
  </div>
</section>

<dialog class="dir-dialog" id="dialog-art" aria-labelledby="dialog-art-title">
  <div class="inner">
    <h3 id="dialog-art-title">Art Projects</h3>
    <p>
      This direction is not part of the first release. The page is in progress
      and will open in a later version. Meanwhile, AI Development is fully
      available.
    </p>
    <div class="actions">
      <a class="dialog-cta" href="/development"
        >Explore AI Development <span aria-hidden="true">↗</span></a
      >
      <button
        class="close"
        type="button"
        data-close
        aria-label="Close Art Projects dialog"
      >
        Close
      </button>
    </div>
  </div>
</dialog>

<dialog
  class="dir-dialog"
  id="dialog-education"
  aria-labelledby="dialog-education-title"
>
  <div class="inner">
    <h3 id="dialog-education-title">Education &amp; Speaking</h3>
    <p>
      This direction is not part of the first release. The page is in progress
      and will open in a later version. Meanwhile, AI Development is fully
      available.
    </p>
    <div class="actions">
      <a class="dialog-cta" href="/development"
        >Explore AI Development <span aria-hidden="true">↗</span></a
      >
      <button
        class="close"
        type="button"
        data-close
        aria-label="Close Education and Speaking dialog"
      >
        Close
      </button>
    </div>
  </div>
</dialog>

<dialog class="dir-dialog" id="dialog-blog" aria-labelledby="dialog-blog-title">
  <div class="inner">
    <h3 id="dialog-blog-title">Blog</h3>
    <p>
      This direction is not part of the first release. The page is in progress
      and will open in a later version. Meanwhile, AI Development is fully
      available.
    </p>
    <div class="actions">
      <a class="dialog-cta" href="/development"
        >Explore AI Development <span aria-hidden="true">↗</span></a
      >
      <button
        class="close"
        type="button"
        data-close
        aria-label="Close Blog dialog"
      >
        Close
      </button>
    </div>
  </div>
</dialog>

<script>
  let lastFocusedTrigger: HTMLElement | null = null;

  document.querySelectorAll('[data-dialog]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.getAttribute('data-dialog');
      const dialog = id && document.getElementById(id);
      if (dialog instanceof HTMLDialogElement) {
        lastFocusedTrigger = trigger as HTMLElement;
        dialog.showModal();
      }
    });
  });

  document.querySelectorAll('dialog.dir-dialog').forEach((dialog) => {
    const el = dialog as HTMLDialogElement;
    const returnFocus = () => {
      if (lastFocusedTrigger) {
        lastFocusedTrigger.focus();
        lastFocusedTrigger = null;
      }
    };

    el.addEventListener('close', returnFocus);

    el.addEventListener('click', (event) => {
      if (event.target === el) el.close();
    });

    el.querySelector('[data-close]')?.addEventListener('click', () => {
      el.close();
    });
  });
</script>

<style>
  .dir-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .dir-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 24px;
    width: 100%;
    min-width: 0;
    padding: clamp(20px, 3vw, 32px) clamp(20px, 3vw, 32px);
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    box-shadow: var(--shadow-sm);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    color: var(--ink);
    transition:
      border-color var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .dir-row:active {
    transform: translateY(1px);
  }

  .dir-name {
    font-size: clamp(30px, 4.6vw, 58px);
    font-weight: 660;
    letter-spacing: -0.04em;
    line-height: 1;
    overflow-wrap: break-word;
    min-width: 0;
    color: var(--ink);
  }

  .dir-meta {
    font-size: var(--type-small);
    color: var(--mute);
    transition: color var(--dur-normal) var(--ease-out);
  }

  .dir-arrow {
    font-size: clamp(24px, 3vw, 36px);
    transition:
      transform var(--dur-normal) var(--ease-out),
      color var(--dur-normal) var(--ease-out);
  }

  .dir-row.active:hover,
  .dir-row.active:focus-visible {
    border-color: rgba(11, 11, 11, 0.2);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .dir-row.active:hover .dir-arrow {
    transform: translate(3px, -3px);
    color: var(--signal);
  }

  .muted-row {
    cursor: pointer;
    background: rgba(255, 255, 255, 0.45);
    border: 1px dashed var(--rule-strong);
    box-shadow: none;
  }

  .muted-row .dir-name {
    color: var(--faint);
    transition: color var(--dur-normal) var(--ease-out);
  }

  .muted-row:hover,
  .muted-row:focus-visible {
    border-color: var(--ink);
    background: #fff;
  }

  .muted-row:hover .dir-name,
  .muted-row:focus-visible .dir-name {
    color: var(--ink);
  }

  .dir-hint {
    font-size: var(--type-small);
    letter-spacing: 0.01em;
    color: var(--faint);
    grid-column: 2 / 4;
    justify-self: end;
  }

  @media (max-width: 640px) {
    .dir-row {
      grid-template-columns: 1fr auto;
      gap: 12px;
      padding: 20px;
    }

    .dir-meta {
      grid-column: 1 / 3;
      order: 3;
    }

    .dir-arrow {
      order: 2;
    }

    .dir-hint {
      grid-column: 1 / 3;
      justify-self: start;
    }
  }
</style>
