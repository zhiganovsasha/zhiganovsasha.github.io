<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.case-nav a'));
  if ('IntersectionObserver' in window && links.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            if (link.hash === `#${entry.target.id}`) {
              link.setAttribute('aria-current', 'location');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        });
      },
      { rootMargin: '-20% 0px -65% 0px' }
    );
    links.forEach((link) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (target) observer.observe(target);
    });
  }

  // lieflat-charts Mono grammar (F5 tick rows, F11 tick gauge), adapted to this site:
  // square corners, flat surfaces, one crimson accent per chart, deterministic rnd,
  // reveal-on-scroll with a prefers-reduced-motion fallback.
  (() => {
    const INK = '#0b0b0b';
    const SIGNAL = '#960018';
    const MUTED = '#6a6a6a';
    const FAINT = '#b0b0b0';
    const GRID = '#dedede';
    const L5 = '#c6c6c6';

    const NS = 'http://www.w3.org/2000/svg';
    const el = (p: Element, t: string, a: Record<string, string | number>) => {
      const n = document.createElementNS(NS, t);
      for (const k in a) n.setAttribute(k, String(a[k]));
      p.appendChild(n);
      return n;
    };
    const txt = (p: Element, a: Record<string, string | number>, s: string) => {
      const n = el(p, 'text', a);
      n.textContent = s;
      return n;
    };
    const tip = (n: Element, s: string) => {
      const t = document.createElementNS(NS, 'title');
      t.textContent = s;
      n.appendChild(t);
    };
    const rnd = (i: number, k: number) => Math.abs(((i * 73856093) ^ (k * 19349663)) % 1000) / 1000;
    const D2R = Math.PI / 180;
    const pol = (cx: number, cy: number, r: number, deg: number) => [
      cx + r * Math.cos(deg * D2R),
      cy + r * Math.sin(deg * D2R),
    ];

    const obsReveal = (id: string, fn: (s: SVGSVGElement) => void) => {
      const n = document.getElementById(id) as SVGSVGElement | null;
      if (!n) return;
      const go = () => {
        n.innerHTML = '';
        fn(n);
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (es) => {
            if (es[0].isIntersecting) {
              go();
              io.disconnect();
            }
          },
          { threshold: 0.3 }
        );
        io.observe(n);
      } else {
        go();
      }
    };

    // F5 tick rows, bulk sources (wide)
    obsReveal('lf-sources', (s) => {
      const D: Array<[string, number, string, boolean]> = [
        ['IMDB', 103, '102.6M', true],
        ['DISCOGS + MUSICBRAINZ', 10, '10,284,281', false],
        ['YANDEX MUSIC', 6, '6,039,445', false],
        ['TMDB', 5, '5,051,606', false],
        ['KINOPOISK', 1, '1,060,836', false],
        ['STATE REGISTRIES', 0, '380,000+', false],
        ['STEAM', 0, '148,909', false],
      ];
      const X0 = 196, PX = 4.9, MAX = 103;
      const y0 = (i: number) => 46 + i * 40;
      D.forEach(([name, v, exact, hero], i) => {
        const y = y0(i);
        txt(s, { x: 186, y: y + 3, 'font-size': 8, 'font-weight': 700, fill: '#4a4a4a',
          'text-anchor': 'end', 'letter-spacing': '.08em', class: 'lf-fade',
          style: `animation-delay:${i * 0.08}s` }, name);
        el(s, 'line', { x1: X0, y1: y + 9, x2: X0 + MAX * PX, y2: y + 9, stroke: GRID,
          'stroke-width': 0.6, class: 'lf-fade', style: `animation-delay:${i * 0.08}s` });
        if (v === 0) {
          // below the 1M unit: one short stub with the exact value labeled
          el(s, 'line', { x1: X0 + PX / 2, y1: y + 9, x2: X0 + PX / 2, y2: y + 4.5,
            stroke: L5, 'stroke-width': 0.9, opacity: 0.9, class: 'lf-fade',
            style: `animation-delay:${i * 0.08}s` });
        }
        for (let k = 0; k < v; k++) {
          const x = X0 + k * PX + PX / 2, h = 9 + rnd(k + 1, i + 2) * 6;
          el(s, 'line', { x1: x, y1: y + 9, x2: x, y2: y + 9 - h,
            stroke: hero ? SIGNAL : INK, 'stroke-width': 0.9,
            opacity: 0.55 + rnd(k + 3, i + 5) * 0.45, class: 'lf-fade',
            style: `animation-delay:${i * 0.08 + k * 0.006}s` });
          if (k % 5 === 4) el(s, 'circle', { cx: x, cy: y + 13.5, r: 0.8, fill: L5,
            class: 'lf-fade', style: `animation-delay:${i * 0.08 + k * 0.006}s` });
        }
        const lab = txt(s, { x: X0 + Math.max(v, 1) * PX + 10, y: y + 4, 'font-size': 11,
          'font-weight': 800, fill: hero ? SIGNAL : INK, class: 'lf-fade',
          style: `animation-delay:${0.4 + i * 0.08}s` }, exact);
        tip(lab, `${name} — ${exact} rows screened`);
      });
      txt(s, { x: 380, y: 332, 'font-size': 7, 'font-weight': 600, fill: FAINT,
        'text-anchor': 'middle', 'letter-spacing': '.12em', class: 'lf-fade',
        style: 'animation-delay:1s' },
        '1 TICK = 1M ROWS, ROUNDED TO THE NEAREST MILLION, DOT MARKS EVERY FIFTH, SHORT STUBS FALL BELOW THE UNIT');
    });

    // F11 tick gauge, roster coverage
    obsReveal('lf-enriched', (s) => {
      const GOAL = 95;
      const cx = 200, cy = 190, R0 = 104, A0 = -195, SW = 210; // -195 deg to +15 deg
      for (let k = 0; k < 100; k++) {
        const a = A0 + (k / 100) * SW, inked = k < GOAL;
        const len = inked ? 13 + rnd(k + 1, 3) * 6 : 5 + rnd(k + 1, 7) * 2.5;
        const [x1, y1] = pol(cx, cy, R0, a), [x2, y2] = pol(cx, cy, R0 + len, a);
        el(s, 'line', { x1, y1, x2, y2, stroke: inked ? SIGNAL : '#cfcfcf',
          'stroke-width': inked ? 1 : 0.6, class: 'lf-fade',
          style: `animation-delay:${k * 0.012}s` });
      }
      [25, 50, 75, 100].forEach((m) => {
        const a = A0 + (m / 100) * SW, [dx, dy] = pol(cx, cy, R0 - 7, a),
          [tx2, ty2] = pol(cx, cy, R0 - 19, a);
        el(s, 'circle', { cx: dx, cy: dy, r: 1, fill: FAINT, class: 'lf-fade',
          style: 'animation-delay:.8s' });
        txt(s, { x: tx2, y: ty2 + 3, 'font-size': 7, 'font-weight': 600, fill: L5,
          'text-anchor': 'middle', class: 'lf-fade', style: 'animation-delay:.85s' }, String(m));
      });
      const aT = A0 + (GOAL / 100) * SW, [ex, ey] = pol(cx, cy, R0 + 20, aT);
      el(s, 'circle', { cx: ex, cy: ey, r: 2.4, fill: SIGNAL, class: 'lf-pop',
        style: 'animation-delay:1.1s' });
      const num = txt(s, { x: cx, y: cy - 4, 'font-size': 34, 'font-weight': 800, fill: INK,
        'text-anchor': 'middle', class: 'lf-fade', style: 'animation-delay:1s' }, '95.0%');
      tip(num, '1,437 of 1,513 professionals enriched');
      txt(s, { x: cx, y: cy + 16, 'font-size': 8, 'font-weight': 600, fill: MUTED,
        'text-anchor': 'middle', 'letter-spacing': '.1em', class: 'lf-fade',
        style: 'animation-delay:1.05s' }, '1,437 OF 1,513 ENRICHED');
      txt(s, { x: 200, y: 300, 'font-size': 7, 'font-weight': 600, fill: FAINT,
        'text-anchor': 'middle', 'letter-spacing': '.12em', class: 'lf-fade',
        style: 'animation-delay:1.2s' },
        'ONE TICK = 1% OF THE ROSTER, INKED = ENRICHED, 76 WITHOUT A VERIFIED RECORD');
    });
  })();
</script>

<style is:global>
  /* lieflat chart animation classes and SVG text font must reach elements created at runtime,
     which never carry Astro's scoping attribute. Names are lf- prefixed to stay contained. */
  .lf-pop {
    transform-box: fill-box;
    transform-origin: center;
    animation: lf-pop 0.5s cubic-bezier(0.25, 1, 0.5, 1) both;
  }
  @keyframes lf-pop {
    from { transform: scale(0); }
    to { transform: none; }
  }
  .lf-fade {
    animation: lf-fade 0.9s cubic-bezier(0.25, 1, 0.5, 1) both;
  }
  @keyframes lf-fade {
    from { opacity: 0; }
  }
  #lf-sources text,
  #lf-enriched text {
    font-family: 'Inter', sans-serif;
  }
  @media (prefers-reduced-motion: reduce) {
    .lf-pop,
    .lf-fade {
      animation: none;
    }
  }
</style>

