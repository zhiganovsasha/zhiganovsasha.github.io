---
const skills = [
  {
    name: 'sasha',
    description:
      'Writes and edits Russian interface, marketing, and documentation text.',
    url: 'https://github.com/mishanaer/deslop/blob/main/sasha/SKILL.md',
  },
  {
    name: 'ai-seo',
    description:
      'Optimizes content so AI search engines cite it in generated answers.',
    url: 'https://github.com/coreyhaines31/marketingskills/tree/main/skills/ai-seo',
  },
  {
    name: 'diagram-design',
    description:
      'Creates standalone HTML, SVG, and PNG diagrams for visual explanations.',
    url: 'https://github.com/cathrynlavery/diagram-design',
  },
  {
    name: 'impeccable',
    description:
      'Designs, critiques, and polishes frontend interfaces to a high standard.',
    url: 'https://github.com/pbakaus/impeccable',
  },
  {
    name: 'ponytail',
    description:
      'Forces the simplest solution that works: less code, fewer dependencies.',
    url: 'https://github.com/DietrichGebert/ponytail',
  },
  {
    name: 'web-design-guidelines',
    description:
      'Reviews UI code against Web Interface Guidelines and accessibility rules.',
    url: 'https://github.com/vercel-labs/web-interface-guidelines',
  },
];
---

<section class="section skills" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="skills-title">My Favorite Agent Skills</h2>
      <p class="note">
        Built by their respective authors. I run them in my daily agent
        workflow.
      </p>
    </div>
    <ul class="skills-grid" role="list">
      {
        skills.map((skill) => (
          <li class="skill-card">
            <h3 translate="no">{skill.name}</h3>
            <p>{skill.description}</p>
            <a
              class="gh-btn"
              href={skill.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`GitHub repository for ${skill.name} skill (opens in a new tab)`}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
              </svg>
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .note {
    max-width: 300px;
    font-size: var(--type-small);
    color: var(--mute);
    margin: 0;
  }

  .skills-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  .skill-card {
    background: var(--bg-surface);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-sm);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition:
      border-color var(--dur-normal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-out),
      transform var(--dur-normal) var(--ease-out);
  }

  .skill-card:hover {
    border-color: rgba(11, 11, 11, 0.2);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .skill-card h3 {
    margin: 0;
    font-size: var(--type-lead);
    font-weight: 650;
    letter-spacing: -0.02em;
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Consolas, monospace;
    overflow-wrap: break-word;
    min-width: 0;
  }

  .skill-card p {
    margin: 0;
    font-size: var(--type-body);
    color: var(--mute);
    flex: 1;
    overflow-wrap: break-word;
  }

  .gh-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--type-small);
    font-weight: 550;
    text-decoration: none;
    color: #1f2328;
    background: #f6f8fa;
    border: 1px solid rgba(31, 35, 40, 0.15);
    box-shadow: var(--shadow-xs);
    min-height: 44px;
    padding: 10px 16px;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .gh-btn:hover {
    background: #eef1f4;
    border-color: rgba(31, 35, 40, 0.3);
  }

  .gh-btn:active {
    transform: translateY(1px);
  }
</style>
