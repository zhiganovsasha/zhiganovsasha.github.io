<script>
  const search = document.querySelector<HTMLElement>('[data-brain-search]');
  if (search) {
    const controls = search.querySelector<HTMLElement>('.search-controls');
    const caption = search.querySelector<HTMLElement>('.step-caption');
    const buttons = search.querySelectorAll<HTMLButtonElement>('[data-search-step]');
    const parts = search.querySelectorAll<HTMLElement>('[data-search-part]');
    const captions: Record<string, string> = {
      '1': 'The question remembers an effect and a date instead of a filename.',
      '2': 'Semantic, keyword, and temporal retrieval run in parallel to collect different kinds of candidates.',
      '3': 'The system combines the candidate lists while keeping every source ID attached.',
      '4': 'The AI agent receives RAG context, writes the answer, and cites the supporting material.',
    };
    const showStep = (step: string, updateUrl = false) => {
      const validStep = captions[step] ? step : '4';
      search.dataset.current = validStep;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.searchStep === validStep)));
      parts.forEach((part) => part.classList.toggle('is-active', part.dataset.searchPart === validStep));
      if (caption) caption.textContent = captions[validStep];
      if (updateUrl && window.history && window.history.replaceState) {
        const url = new URL(window.location.href);
        if (validStep === '4') {
          url.searchParams.delete('step');
        } else {
          url.searchParams.set('step', validStep);
        }
        window.history.replaceState(null, '', url.toString());
      }
    };
    buttons.forEach((button) => button.addEventListener('click', () => showStep(button.dataset.searchStep || '4', true)));
    if (controls) controls.hidden = false;
    search.classList.add('is-interactive');
    const initialStep = new URLSearchParams(window.location.search).get('step') || '4';
    showStep(initialStep, false);
  }
  const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('.brain-nav a');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        sectionLinks.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      });
    }, { rootMargin: '-20% 0px -65% 0px' });
    document.querySelectorAll('.brain-explainer section[id]').forEach((section) => observer.observe(section));
  }
</script>
