<script>
const explainer = document.querySelector('.lifecycle');
  if (explainer) {
    const stages = Array.from(explainer.querySelectorAll('[data-stage]'));
    const copies = Array.from(explainer.querySelectorAll('[data-stage-copy]'));
    const position = explainer.querySelector('.stage-position');
    const previous = explainer.querySelector('[data-previous]');
    const next = explainer.querySelector('[data-next]');
    const replay = explainer.querySelector('[data-replay]');
    let current = 1;
    let timer;

    const getStageFromUrl = () => {
      const hashMatch = window.location.hash.match(/^#stage-(\d+)$/);
      if (hashMatch) {
        const val = parseInt(hashMatch[1], 10);
        if (!isNaN(val) && val >= 1 && val <= stages.length) return val;
      }
      const params = new URLSearchParams(window.location.search);
      const stageParam = params.get('stage');
      if (stageParam) {
        const val = parseInt(stageParam, 10);
        if (!isNaN(val) && val >= 1 && val <= stages.length) return val;
      }
      return null;
    };

    const show = (value, syncUrl = true) => {
      current = Math.min(Math.max(value, 1), stages.length);
      stages.forEach((stage) => {
        const stageNumber = Number(stage.dataset.stage);
        const state = stageNumber === current ? 'current' : stageNumber < current ? 'complete' : 'future';
        stage.dataset.state = state;
        stage.setAttribute('aria-pressed', String(stageNumber === current));
      });
      copies.forEach((copy) => {
        copy.hidden = Number(copy.dataset.stageCopy) !== current;
      });
      if (position) position.textContent = current + ' / ' + stages.length;
      if (previous) previous.disabled = current === 1;
      if (next) next.disabled = current === stages.length;
      if (syncUrl) {
        history.replaceState(null, '', '#stage-' + current);
      }
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
      if (replay) replay.textContent = 'Replay';
    };

    stages.forEach((stage) => {
      stage.addEventListener('click', () => {
        stop();
        show(Number(stage.dataset.stage));
      });
    });
    previous?.addEventListener('click', () => { stop(); show(current - 1); });
    next?.addEventListener('click', () => { stop(); show(current + 1); });
    replay?.addEventListener('click', () => {
      if (timer !== undefined) { stop(); return; }
      show(1);
      replay.textContent = 'Pause';
      timer = window.setInterval(() => {
        if (current === stages.length) { stop(); return; }
        show(current + 1);
      }, 1600);
    });

    const syncFromUrl = () => {
      const urlStage = getStageFromUrl();
      if (urlStage !== null && urlStage !== current) {
        stop();
        show(urlStage, false);
      }
    };

    window.addEventListener('popstate', syncFromUrl);
    window.addEventListener('hashchange', syncFromUrl);

    const initial = getStageFromUrl();
    show(initial !== null ? initial : 1, initial !== null);
  }
</script>

